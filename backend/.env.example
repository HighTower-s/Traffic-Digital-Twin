PORT=3000

# บันทึก payload ทุกก้อนที่ broadcast ลง backend/data/output/*.jsonl
# (spawn / spawn_vehicle / traffic_state) — ไฟล์ถูกล้างใหม่ทุกครั้งที่เซิร์ฟเวอร์เริ่ม
# ตั้งเป็น false ถ้าไม่อยากให้เขียนไฟล์
# CAPTURE_PAYLOADS=true

# The Prototype backend has no database — DB_* vars below are for MVP only,
# not used by the current spawn-event + in-memory counters code path.
# ENABLE_DB_LOGGING=false
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smartflow
# DB_USER=smartflow
# DB_PASSWORD=changeme
